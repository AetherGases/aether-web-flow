NODE_ENV=development
HOST=127.0.0.1
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
MS_AUTH_URL=http://localhost:8080
# Configure a origem do ms-inventory para habilitar os dados da overview.
# MS_INVENTORY_URL=http://localhost:3003
# MS_CALCULATOR_URL=https://aethergases.org
# Origem do ms-aeko-hub, sem caminho. As rotas utilizadas começam com /ai.
# MS_AI_URL=https://aethergases.org
# No gateway publicado, use /hub; para acesso direto local, deixe vazio.
# MS_AI_PATH_PREFIX=/hub
AI_TIMEOUT_MS=60000
# Gere uma chave aleatória com pelo menos 32 caracteres. Não use esta descrição como chave.
SESSION_SECRET=
SESSION_MAX_AGE_MS=28800000
UPSTREAM_TIMEOUT_MS=5000
TRUST_PROXY_HOPS=0
# Obrigatório em produção; opcional no desenvolvimento (sessões em memória).
# REDIS_URL=redis://localhost:6379
